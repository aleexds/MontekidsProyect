    {
      "parameters": {
        "jsCode": "// Obtenemos los datos que mandó React desde el webhook principal\nconst webhookData = $('Webhook').first().json.body; \nconst userCode = webhookData.code; // El código de 6 dígitos que envió el frontend\nconst userEmail = webhookData.email;\n\n// Y el usuario que viene de json-server (el nodo anterior)\nconst dbUser = $input.first().json;\n\n// Si json-server devuelve un array o un objeto directo:\nconst usuario = Array.isArray(dbUser) ? dbUser[0] : dbUser;\n\nif (!usuario) {\n  return [{ json: { success: false, message: \"El usuario no existe.\" } }];\n}\n\nconst storedCode = usuario.resetCode;\nconst expiresAt = usuario.resetCodeExpiresAt;\nconst now = new Date();\n\n// 1. Validar si el código existe en la BD\nif (!storedCode) {\n  return [{ json: { success: false, message: \"No hay ninguna solicitud de código activa para este correo.\" } }];\n}\n\n// 2. Validar si expiró\nif (expiresAt && new Date(expiresAt) < now) {\n  return [{ json: { success: false, message: \"El código de verificación ha expirado. Solicita uno nuevo.\" } }];\n}\n\n// 3. Validar si coinciden estrictamente\nif (String(storedCode).trim() !== String(userCode).trim()) {\n  return [{ json: { success: false, message: \"El código de verificación es incorrecto.\" } }];\n}\n\n// 4. Todo correcto\nreturn [{ json: { success: true, message: \"Código validado correctamente.\" } }];"
      },
